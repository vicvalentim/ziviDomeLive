title: "ziviDomeLive: Processing library for immersive fulldome visuals"
version: "1.5.0"
doi: "10.5281/zenodo.15671506"
authors:
  - family-names: Valentim
    given-names: Victor
    orcid: "https://orcid.org/0000-0002-0282-7947"
    affiliation: "UFRB – Center for Culture, Languages and Applied Technologies (CECULT)"
license: GPL-2.0-only
keywords:
  - fulldome
